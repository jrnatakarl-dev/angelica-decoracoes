# Copie para .env e substitua pelos valores da sua infraestrutura.
SITE_DOMAIN=loja.seudominio.com.br
STORE_PICKUP_ENABLED=0
STORE_PICKUP_LABEL=Retirada no ateliê
# Só habilite a retirada depois de informar o endereço completo e confirmado.
STORE_PICKUP_ADDRESS=
MP_ACCESS_TOKEN=TEST-substitua-pelo-token-da-aplicacao
MP_WEBHOOK_SECRET=substitua-pelo-segredo-do-webhook
ME_ACCESS_TOKEN=substitua-pelo-token-OAuth-do-Melhor-Envio
ME_SANDBOX=1
ME_FROM_POSTAL_CODE=00000000
# Informe as dimensões e o peso REAIS de cada produto embalado.
ME_PRODUCT_DEPTH_CM=0
ME_PRODUCT_WEIGHT_KG=0
ME_USER_AGENT=Angelica Casa (suporte@seudominio.com.br)
# Dados de remetente exigidos ao preparar uma etiqueta (não publique estes dados).
ME_FROM_NAME=
ME_FROM_EMAIL=
ME_FROM_PHONE=
ME_FROM_DOCUMENT=
ME_FROM_ADDRESS=
ME_FROM_NUMBER=
ME_FROM_COMPLEMENT=
ME_FROM_DISTRICT=
ME_FROM_CITY=
ME_FROM_UF=
ME_FROM_STATE_REGISTER=ISENTO
